# Copie para .env.local (fora do git) e preencha só o que for usar.
# Sem nenhuma chave, o pipeline usa edge-tts (voz grátis) e SFX sintetizados offline.

# ElevenLabs: TTS com timestamps, clonagem de voz e SFX por prompt
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# tools/upload_server.py: exige ?t=<token> em cada envio pela rede local
UPLOAD_TOKEN=
